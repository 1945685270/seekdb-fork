 int ObFtsIndexBuildTask::process()
+{
+  int ret = OB_SUCCESS;
+  // Bound the amount of synchronous work so other DDL tasks remain fair.
+  // A persisted state transition can run its successor without another queue
+  // round trip. Unchanged/waiting states keep the scheduler's normal backoff.
+  const int64_t max_stages = is_fts_task() ? 4 : 1;
+  for (int64_t i = 0; i < max_stages; ++i) {
+    const int64_t previous_status = task_status_;
+    ret = process_one_stage();
+    if (OB_SUCCESS != ret || !need_retry() || task_status_ == previous_status
+        || ObDDLTaskStatus::FAIL == task_status_
+        || ObDDLTaskStatus::SUCCESS == task_status_) {
+      break;
+    }
+  }
+  return ret;
+}
